
<!DOCTYPE html>
<html lang="sw">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Billyphysics Quiz</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  font-family: Arial, sans-serif;
  color: white;
  background: linear-gradient(135deg, #07091d, #17134b, #310d46);
}

.card {
  width: 100%;
  max-width: 480px;
  padding: 30px 22px;
  text-align: center;
  border: 1px solid #786cff;
  border-radius: 25px;
  background: rgba(16, 20, 58, 0.95);
  box-shadow: 0 0 35px #5835ff55;
  position: relative;
  z-index: 2;
}

h1 {
  color: #49eaff;
  font-size: 32px;
}

p {
  color: #d4d9ff;
  line-height: 1.7;
}

button {
  cursor: pointer;
  border: none;
  border-radius: 12px;
  padding: 15px;
  font-size: 16px;
  font-weight: bold;
  transition: 0.2s;
}

button:hover {
  transform: scale(1.04);
}

.start, .next {
  width: 100%;
  color: #101337;
  background: linear-gradient(90deg, #49eaff, #bb8cff);
}

.answers {
  display: flex;
  gap: 12px;
  margin-top: 25px;
}

.answers button {
  width: 50%;
  color: white;
  background: #282b68;
  border: 1px solid #786cff;
}

.answers button:hover {
  background: #593bba;
}

.progress {
  height: 8px;
  background: #303252;
  border-radius: 20px;
  overflow: hidden;
  margin: 20px 0;
}

#bar {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, #49eaff, #ff62d5);
  transition: width 0.4s;
}

#fireworks {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 5;
}

#quiz, #result {
  display: none;
}

#question {
  font-size: 25px;
  line-height: 1.4;
}

.amount {
  color: #ffdb65;
  font-size: 38px;
  font-weight: 900;
  margin: 20px 0;
  text-shadow: 0 0 20px #ffb70055;
}

.footer {
  margin-top: 28px;
  font-size: 12px;
  letter-spacing: 2px;
  color: #aab4ff;
}

.small {
  font-size: 12px;
  color: #aab4d9;
}
</style>
</head>

<body>
<canvas id="fireworks"></canvas>

<div class="card">
  <div id="welcome">
    <div style="font-size:40px">🎆✨🎁</div>
    <h1>Billyphysics Quiz</h1>
    <p>
      Karibu kwenye challenge! Jibu maswali matano
      ya Ndiyo au Hapana na uone surprise yako mwisho.
    </p>
    <button class="start" onclick="startQuiz()">
      ANZA CHALLENGE 🚀
    </button>
  </div>

  <div id="quiz">
    <p id="counter">SWALI 1 KATI YA 5</p>
    <div class="progress"><div id="bar"></div></div>
    <h2 id="question"></h2>

    <div class="answers">
      <button onclick="answer('Ndiyo')">✓ Ndiyo</button>
      <button onclick="answer('Hapana')">✕ Hapana</button>
    </div>
  </div>

  <div id="result">
    <div style="font-size:65px">🏆🎉</div>
    <h1>Hongera sana!</h1>
    <p>Umejibu maswali yote. Umefika mwisho wa challenge!</p>

    <div class="amount">TSh 5,000/=</div>
    <p>🎊 Ujumbe wako wa mwisho wa mchezo!</p>

    <p class="small">
      Kumbuka: Hii ni quiz ya burudani.
      Hakuna pesa halisi iliyotumwa.
    </p>

    <button class="start" onclick="shareQuiz()">
      SHIRIKI QUIZ ↗
    </button>

    <br><br>

    <button onclick="restart()" style="background:#292d63;color:white;width:100%">
      🔄 CHEZA TENA
    </button>
  </div>

  <div class="footer">MADE WITH ✦ BY BILLYPHYSICS</div>
</div>

<script>
const questions = [
  "Wewe ni Cosmas?",
  "Unapenda surprise za kushtukiza?",
  "Unaamini bahati inaweza kukufuata leo?",
  "Uko tayari kuona matokeo yako?",
  "Umefurahia challenge hii?"
];

let current = 0;
let locked = false;

function startQuiz() {
  document.getElementById("welcome").style.display = "none";
  document.getElementById("quiz").style.display = "block";
  current = 0;
  showQuestion();
  fireworks(70);
}

function showQuestion() {
  document.getElementById("question").textContent =
    questions[current];

  document.getElementById("counter").textContent =
    `SWALI ${current + 1} KATI YA ${questions.length}`;

  document.getElementById("bar").style.width =
    ((current + 1) / questions.length * 100) + "%";
}

function answer(choice) {
  if (locked) return;
  locked = true;

  // Show fireworks after every answer.
  fireworks(45);

  setTimeout(() => {
    current++;

    if (current < questions.length) {
      showQuestion();
    } else {
      document.getElementById("quiz").style.display = "none";
      document.getElementById("result").style.display = "block";
      fireworks(180);
    }

    locked = false;
  }, 450);
}

function restart() {
  current = 0;
  locked = false;
  document.getElementById("result").style.display = "none";
  document.getElementById("welcome").style.display = "block";
  document.getElementById("bar").style.width = "0";
  fireworks(40);
}

async function shareQuiz() {
  const data = {
    title: "Billyphysics Quiz",
    text: "Jaribu quiz hii ya burudani! 🎆",
    url: location.href
  };

  try {
    if (navigator.share) {
      await navigator.share(data);
    } else {
      await navigator.clipboard.writeText(location.href);
      alert("Link imenakiliwa!");
    }
  } catch (e) {
    console.log("Sharing cancelled or unavailable.");
  }
}

// Fireworks animation using HTML Canvas.
const canvas = document.getElementById("fireworks");
const ctx = canvas.getContext("2d");
let particles = [];

function resizeCanvas() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}

resizeCanvas();
window.addEventListener("resize", resizeCanvas);

function fireworks(count) {
  const x = Math.random() * canvas.width;
  const y = Math.random() * canvas.height * 0.65;
  const colors = [
    "#49eaff", "#ff62d5", "#ffdb65",
    "#a78bfa", "#ffffff", "#6bffb1"
  ];

  for (let i = 0; i < count; i++) {
    const angle = Math.random() * Math.PI * 2;
    const speed = 1 + Math.random() * 5;

    particles.push({
      x, y,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed,
      life: 70,
      color: colors[Math.floor(Math.random() * colors.length)]
    });
  }

  if (!animating) {
    animating = true;
    animate();
  }
}

let animating = false;

function animate() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  particles = particles.filter(p => p.life > 0);

  particles.forEach(p => {
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.035;
    p.life--;

    ctx.globalAlpha = p.life / 70;
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, 2.5, 0, Math.PI * 2);
    ctx.fill();
  });

  ctx.globalAlpha = 1;

  if (particles.length > 0) {
    requestAnimationFrame(animate);
  } else {
    animating = false;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
}
</script>
</body>
</html>
